{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvex.dev/ns/v0.2.0/schema.json",
  "title": "OpenVEX Document v0.2.0",
  "description": "Strict schema for OpenVEX v0.2.0 Vulnerability Exploitability eXchange documents.",
  "type": "object",
  "required": ["@context", "@id", "author", "timestamp", "version", "statements"],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string",
      "const": "https://openvex.dev/ns/v0.2.0"
    },
    "@id": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tooling": {
      "type": "string"
    },
    "statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "required": ["@id"],
      "additionalProperties": false,
      "properties": {
        "@id": { "type": "string", "minLength": 1 },
        "identifiers": {
          "type": "object",
          "properties": {
            "purl": { "type": "string" },
            "cpe23": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "hashes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "subcomponents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["@id"],
            "properties": {
              "@id": { "type": "string", "minLength": 1 },
              "identifiers": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "vulnerability": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "@id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "statement": {
      "type": "object",
      "required": ["vulnerability", "products", "status"],
      "additionalProperties": false,
      "properties": {
        "vulnerability": { "$ref": "#/$defs/vulnerability" },
        "timestamp": { "type": "string", "format": "date-time" },
        "last_updated": { "type": "string", "format": "date-time" },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/product" }
        },
        "status": {
          "type": "string",
          "enum": ["not_affected", "affected", "fixed", "under_investigation"]
        },
        "status_notes": { "type": "string" },
        "supplier": { "type": "string" },
        "justification": {
          "type": "string",
          "enum": [
            "component_not_present",
            "vulnerable_code_not_present",
            "vulnerable_code_not_in_execute_path",
            "vulnerable_code_cannot_be_controlled_by_adversary",
            "inline_mitigations_already_exist"
          ]
        },
        "impact_statement": { "type": "string" },
        "action_statement": { "type": "string" },
        "action_statement_timestamp": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "not_affected" } },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              { "required": ["justification"] },
              { "required": ["impact_statement"] }
            ]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "affected" } },
            "required": ["status"]
          },
          "then": {
            "required": ["action_statement"]
          }
        },
        {
          "if": {
            "properties": { "status": { "not": { "const": "not_affected" } } }
          },
          "then": {
            "not": { "required": ["justification"] }
          }
        }
      ]
    }
  }
}
